\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Reaction-rate enhancement factor $\mathcal  {F}_\mathrm  {sc}$ [Equation\nobreakspace  {}(\ref {eq:goldF})] near a fully ionized gold catalyst, as\nobreakspace  {}a function of plasma temperature, for\nobreakspace  {}$p$-${}^{11}$B (black solid), $d$-$t$ (blue dashed), $d$-$d$ (red dotted), and\nobreakspace  {}$d$-${}^3$He (orange dashed). All curves rise slowly at low $T$, where the temperature-independent strong-screening term of Equation\nobreakspace  {}(\ref {eq:screenmass}) dominates, then climb sharply above $\sim $100\nobreakspace  {}keV as thermal electrons increasingly penetrate the gold polarization cloud, before\nobreakspace  {}flattening once $T$ approaches $m_ec^2$. Reprinted from ref.\nobreakspace  {}\cite  {Grayson:2025kva} under \url  {https://creativecommons.org/licenses/by/4.0/} (CC\nobreakspace  {}BY\nobreakspace  {}4.0).\relax }}{41}{figure.caption.18}\protected@file@percent }
\newlabel{fig:GoldEnhance}{{16}{41}{Reaction-rate enhancement factor $\mathcal {F}_\mathrm {sc}$ [Equation~(\ref {eq:goldF})] near a fully ionized gold catalyst, as~a function of plasma temperature, for~$p$-${}^{11}$B (black solid), $d$-$t$ (blue dashed), $d$-$d$ (red dotted), and~$d$-${}^3$He (orange dashed). All curves rise slowly at low $T$, where the temperature-independent strong-screening term of Equation~(\ref {eq:screenmass}) dominates, then climb sharply above $\sim $100~keV as thermal electrons increasingly penetrate the gold polarization cloud, before~flattening once $T$ approaches $m_ec^2$. Reprinted from ref.~\cite {Grayson:2025kva} under \url {https://creativecommons.org/licenses/by/4.0/} (CC~BY~4.0).\relax }{figure.caption.18}{}}
\newlabel{fig:GoldEnhance@cref}{{[figure][16][]16}{[1][40][]41}}
