\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces \texthl  {Effective} screening mass $m_s$ around a finite-sized $^4$He (\,$^8$Be\,) nucleus at the (illustratively chosen) BBN temperature $T=86.7$\nobreakspace  {}keV, as\nobreakspace  {}a function of the local potential $e\phi $. The\nobreakspace  {}self-consistent Fermi--Dirac result (blue dashed) tracks the weak-field Debye value $m_D$ (black) at small $\Phi $ but rises only as a power law at large $\Phi $; the traditionally used Boltzmann approximation (red dashed) instead diverges exponentially, over-predicting screening in the tunneling-relevant window bounded by the Gamow energy $E_G$ and the on-surface potential $e\phi (0)$. Reprinted from ref.\nobreakspace  {}\cite  {Grayson:2024uwg} under \url  {https://creativecommons.org/licenses/by/4.0/} (CC\nobreakspace  {}BY\nobreakspace  {}4.0).\relax }}{39}{figure.caption.16}\protected@file@percent }
\newlabel{fig:ScreenMassFD}{{14}{39}{\hl {Effective} screening mass $m_s$ around a finite-sized $^4$He (\,$^8$Be\,) nucleus at the (illustratively chosen) BBN temperature $T=86.7$~keV, as~a function of the local potential $e\phi $. The~self-consistent Fermi--Dirac result (blue dashed) tracks the weak-field Debye value $m_D$ (black) at small $\Phi $ but rises only as a power law at large $\Phi $; the traditionally used Boltzmann approximation (red dashed) instead diverges exponentially, over-predicting screening in the tunneling-relevant window bounded by the Gamow energy $E_G$ and the on-surface potential $e\phi (0)$. Reprinted from ref.~\cite {Grayson:2024uwg} under \url {https://creativecommons.org/licenses/by/4.0/} (CC~BY~4.0).\relax }{figure.caption.16}{}}
\newlabel{fig:ScreenMassFD@cref}{{[figure][14][]14}{[1][39][]39}}
